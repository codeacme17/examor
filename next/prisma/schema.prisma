generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider     = "mongodb"
  url          = env("NEXT_PUBLIC_DATABASE_URL")
  relationMode = "prisma"
}

model TDocument {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  document   String
  fileId     String   @db.ObjectId
  fileName   String
  noteId     String   @db.ObjectId
  uploadDate DateTime @db.Date

  @@index([noteId])
  @@index([fileId])
}

model TFile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName      String
  isUploading   String
  noteId        String   @db.ObjectId
  questionCount Int
  uploadDate    DateTime @db.Date

  @@index([noteId])
}

model TNote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  icon        String
  isUploading String
  name        String
  uploadDate  DateTime @db.Date
}

model TProfile {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  anthropicKey       String
  anthropicModel     String
  anthropicVersion   String
  azureBase          String
  azureKey           String
  currentModel       String
  currentRole        String
  deploymentName     String
  openaiBase         String
  openaiKey          String
  openaiModel        String
  openaiOrganization String
  openaiProxy        String
  openaiVersion      String
  questionAmount     Int
}

model TQuestion {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  content         String
  designatedRole  String
  documentId      String   @db.ObjectId
  fileId          String   @db.ObjectId
  isAnsweredToday String
  isPushedToday   String
  noteId          String   @db.ObjectId
  progress        Float
  questionType    String
  uploadDate      DateTime @db.Date

  @@index([documentId])
  @@index([fileId])
  @@index([noteId])
}
